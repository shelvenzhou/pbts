# PBTS Configuration for Docker Deployment
# Copy this file to .env and adjust values as needed

# =============================================================================
# Tracker Configuration
# =============================================================================

# Minimum upload/download ratio for private tracker (default: 0.5)
MIN_RATIO=0.5

# Maximum peers returned per announce (default: 50)
MAX_PEERS=50

# TEE mode: "disabled", "enabled", or "benchmark" (default: disabled)
TEE_MODE=enabled

# =============================================================================
# Automatic Experiment Configuration
# =============================================================================
# Experiments run automatically on first container startup
# Results are saved to ./results/ and accessible via HTTP API

# Receipt benchmark iterations (default: 100 for quick results, 1000 for research)
# Higher values = more accurate results but slower startup
RECEIPT_ITERATIONS=100

# Batch sizes for aggregate verification tests (space-separated)
# Default: 10 25 50 100
RECEIPT_BATCH_SIZES=10 25 50 100

# TEE benchmark iterations (default: 50 for quick, 200 for research)
TEE_ITERATIONS=50

# TEE verification iterations (default: 3 for quick, 10 for research)
# WARNING: This is very slow - each iteration takes ~30-60 seconds
TEE_VERIFY_ITERATIONS=3

# =============================================================================
# Skip Flags (Recommended for Fast Cloud Deployment)
# =============================================================================

# Skip TEE benchmarks (automatically skips if TEE not available)
# Uncomment to explicitly skip even if TEE is available
# SKIP_TEE=true

# Skip client download simulation benchmarks (time-consuming, ~5-10 minutes)
# Recommended: skip for production deployments
SKIP_CLIENT_DOWNLOAD=true

# Skip tracker overhead benchmarks (time-consuming, requires running tracker)
# Recommended: skip for production deployments
SKIP_TRACKER_OVERHEAD=true

# =============================================================================
# TEE/TDX Configuration (Optional)
# =============================================================================

# Dstack socket path for TEE access
# For production TDX server (default):
DSTACK_SOCKET=/var/run/dstack.sock
# For local testing with Phala simulator:
# DSTACK_SOCKET=/path/to/your/.phala-cloud/simulator/0.5.3/dstack.sock

# =============================================================================
# Configuration Presets
# =============================================================================

# Fast Cloud Deployment (< 2 minutes startup):
#   RECEIPT_ITERATIONS=50
#   RECEIPT_BATCH_SIZES=10 25 50
#   TEE_ITERATIONS=25
#   TEE_VERIFY_ITERATIONS=2
#   SKIP_CLIENT_DOWNLOAD=true
#   SKIP_TRACKER_OVERHEAD=true

# Standard Deployment (~ 2-5 minutes startup):
#   RECEIPT_ITERATIONS=100
#   RECEIPT_BATCH_SIZES=10 25 50 100
#   TEE_ITERATIONS=50
#   TEE_VERIFY_ITERATIONS=3
#   SKIP_CLIENT_DOWNLOAD=true
#   SKIP_TRACKER_OVERHEAD=true

# Research/Benchmarking (~ 15-30 minutes startup):
#   RECEIPT_ITERATIONS=1000
#   RECEIPT_BATCH_SIZES=10 25 50 100 200
#   TEE_ITERATIONS=200
#   TEE_VERIFY_ITERATIONS=10
#   SKIP_CLIENT_DOWNLOAD=false
#   SKIP_TRACKER_OVERHEAD=false
